# Local development only. Copy to .env and choose a password before starting.
POSTGRES_DB=car_log
POSTGRES_USER=car_log
POSTGRES_PASSWORD=
# Change this if port 5432 is already in use on your machine.
POSTGRES_PORT=5432

# Match the PostgreSQL settings above. URL-encode special characters in credentials.
# Replace YOUR_PASSWORD with your local password. Never prefix this with VITE_.
DATABASE_URL=postgresql://car_log:YOUR_PASSWORD@127.0.0.1:5432/car_log

# Set true to hide registration and reject new accounts, including the first admin.
DISABLE_REGISTRATION=false

# Server-only password pepper: generate 32 random bytes and encode as 64 hex characters.
# Keep this outside the database and preserve it across restarts/deployments.
PASSWORD_PEPPER=

# Argon2id targets for new hashes and upgrades after successful verification.
# Memory is in KiB; these are the recommended baseline settings.
ARGON2_MEMORY=65536
ARGON2_PASSES=3
ARGON2_PARALLELISM=1

# Trusted public origin used in verification links; HTTPS is required in production.
APP_URL=http://localhost:3000
# Local mail capture via `docker compose up -d maildev`.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.test

# Private vehicle-picture storage; persist this directory with the database.
VEHICLE_IMAGE_DIR=.data/vehicle-images

# Optional Compose application example: `docker compose --profile frontend up -d frontend`.
# Set this to an available published image tag before starting the service.
FRONTEND_IMAGE=tfilo/car-log:latest
FRONTEND_PORT=3000
# Containers reach the Compose database at postgres:5432, not 127.0.0.1.
# Match POSTGRES_* above and URL-encode special characters in credentials.
FRONTEND_DATABASE_URL=postgresql://car_log:YOUR_PASSWORD@postgres:5432/car_log
# The frontend service also loads DISABLE_REGISTRATION, APP_URL, PASSWORD_PEPPER,
# ARGON2_*, SMTP_*, and MAIL_FROM from this file. Use your HTTPS origin and real
# SMTP for production.
