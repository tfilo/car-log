{
    "name": "car-log",
    "author": {
        "name": "Tomáš Filo",
        "email": "tfilosk@gmail.com",
        "url": "https://github.com/tfilo/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tfilo/car-log.git"
    },
    "version": "1.0.13",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "npm run db:generate && vite dev",
        "build": "npm run db:generate && vite build",
        "start": "node .output/server/index.mjs",
        "lint": "eslint './src/**/*.{js,jsx,ts,tsx}' './tests/**/*.ts'",
        "lint:fix": "eslint './src/**/*.{js,jsx,ts,tsx}' './tests/**/*.ts' --fix",
        "prettier": "prettier './src/**/*.{js,jsx,ts,tsx,json,md}' --check",
        "prettier:fix": "prettier './src/**/*.{js,jsx,ts,tsx,json,md}' --write",
        "prepare": "husky",
        "db:generate": "prisma generate",
        "db:validate": "prisma validate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "test:db": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:production": "npm run build && E2E_PRODUCTION=true playwright test"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@tanstack/react-devtools": "0.10.13",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.104.3",
        "@tanstack/react-query-devtools": "5.104.3",
        "@tanstack/react-router": "1.170.45",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.3",
        "@tfilo/tope-ui": "0.3.8",
        "csv-parse": "7.0.3",
        "csv-stringify": "6.9.0",
        "dotenv": "18.0.9",
        "fflate": "0.8.3",
        "handlebars": "4.7.10",
        "i18next": "26.7.1",
        "leaflet": "1.9.4",
        "leaflet.markercluster": "1.5.3",
        "nitro": "3.0.260903-beta",
        "nodemailer": "10.3.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.13",
        "react-is": "19.3.1",
        "recharts": "3.10.1",
        "sharp": "0.35.5",
        "srvx": "1.0.5",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@heroicons/react": "2.2.0",
        "@playwright/test": "1.65.0",
        "@rolldown/plugin-babel": "0.2.4",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/eslint-plugin-query": "5.104.3",
        "@types/leaflet": "1.9.22",
        "@types/leaflet.markercluster": "1.5.6",
        "@types/node": "26.6.5",
        "@types/nodemailer": "8.0.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "eslint-plugin-tailwindcss": "4.4.0",
        "globals": "17.13.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.10",
        "prettier-plugin-tailwindcss": "0.8.1",
        "prisma": "7.10.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=24.7.0"
    }
}
