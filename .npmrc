ignore-scripts=true
allow-git=none
allow-remote=root
min-release-age=1
engine-strict=true
audit-level=high
save-exact=true
fund=false
update-notifier=false
# Published UI components are hosted on GitHub Packages.
@tfilo:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
