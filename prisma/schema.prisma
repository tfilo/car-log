generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

model User {
  dataTransfer      DataTransfer?
  storeFuelLocation Boolean            @default(false)
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String             @unique
  username          String             @unique
  firstName         String?
  lastName          String?
  emailVerifiedAt   DateTime?          @db.Timestamptz(3)
  passwordHash      String
  role              UserRole           @default(USER)
  status            UserStatus         @default(PENDING)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  vehicles          Vehicle[]
  sessions          Session[]
  emailVerification EmailVerification?
  passwordReset     PasswordReset?
}

model PasswordReset {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique @db.Uuid
  email     String
  tokenHash String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique @db.Uuid
  email     String
  tokenHash String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// A permanent singleton, not tied to a user or deleted when users are deleted.
model RegistrationState {
  id          Int       @id @default(1)
  completedAt DateTime? @db.Timestamptz(3)
}

enum FuelType {
  PETROL
  DIESEL
  LPG
  CNG
  ELECTRIC
}

model Vehicle {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String       @db.Uuid
  manufacturer     String       @db.VarChar(100)
  model            String       @db.VarChar(100)
  licensePlate     String?      @db.VarChar(30)
  vin              String?      @db.VarChar(32)
  color            String?      @db.VarChar(50)
  registrationDate DateTime?    @db.Date
  fuelTypes        FuelType[]
  pictureId        String?      @unique @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  picture          PictureFile? @relation(fields: [pictureId], references: [id], onDelete: SetNull)
  fuelRecords      FuelRecord[]
  expenses         Expense[]

  @@unique([id, userId])
  @@index([userId, createdAt, id])
}

model FuelRecord {
  locationManuallyAdjusted Boolean   @default(false)
  latitude                 Float?
  longitude                Float?
  locationAccuracy         Float?
  locationCapturedAt       DateTime? @db.Timestamptz(3)
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vehicleId                String    @db.Uuid
  fuelType                 FuelType
  occurredAt               DateTime  @db.Timestamptz(3)
  odometer                 Decimal   @db.Decimal(12, 3)
  quantity                 Decimal   @db.Decimal(12, 3)
  totalPrice               Decimal   @db.Decimal(12, 2)
  unitPrice                Decimal   @db.Decimal(18, 6)
  isFull                   Boolean
  previousRecordMissing    Boolean   @default(false)
  consumptionPer100Km      Decimal?  @db.Decimal(30, 6)
  consumptionDistance      Decimal?  @db.Decimal(12, 3)
  consumptionQuantity      Decimal?  @db.Decimal(18, 3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)
  vehicle                  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, fuelType, occurredAt])
  @@index([vehicleId, occurredAt, id])
}

// Files are staged for cleanup before writing, then attached in a transaction.
model PictureFile {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String    @unique
  deleteAfter DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  vehicle     Vehicle?

  @@index([deleteAfter])
}

model ExpenseCategory {
  serviceIntervalKm     Int?
  serviceIntervalMonths Int?
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String    @db.Uuid
  name                  String    @db.VarChar(100)
  isArchived            Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses              Expense[]

  // Case-insensitive name uniqueness is enforced by the migration's expression index.
  @@unique([id, userId])
  @@index([userId, name, id])
}

model Expense {
  id         String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String          @db.Uuid
  vehicleId  String          @db.Uuid
  categoryId String          @db.Uuid
  totalPrice Decimal         @db.Decimal(10, 2)
  odometer   Decimal         @db.Decimal(12, 3)
  occurredAt DateTime        @db.Timestamptz(3)
  comment    String?         @db.VarChar(1000)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle    Vehicle         @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  category   ExpenseCategory @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([vehicleId, occurredAt, id])
  @@index([categoryId, userId])
  @@index([userId])
}

model DataTransfer {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportState String @default("idle")
  exportKey String?
  expiresAt DateTime? @db.Timestamptz(3)
  importedAt DateTime? @db.Timestamptz(3)
  importError String?
}
