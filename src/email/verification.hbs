<!doctype html>
<html lang="sk">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{subject}}</title></head>
<body style="margin:0;background:#f1f5f9;color:#0f172a;font-family:Arial,sans-serif;">
  <table role="presentation" style="width:100%;padding:32px 16px;"><tr><td align="center">
    <table role="presentation" style="width:100%;max-width:560px;background:#fff;border-radius:12px;padding:32px;">
      <tr><td style="font-size:18px;font-weight:bold;">Tankovanie</td></tr>
      <tr><td><h1 style="font-size:24px;">{{heading}}</h1><p style="line-height:1.6;">{{body}}</p></td></tr>
      <tr><td style="padding:16px 0;"><a href="{{link}}" style="display:inline-block;padding:14px 24px;background:#2563eb;color:#fff;border-radius:6px;text-decoration:none;">{{button}}</a></td></tr>
      <tr><td><p style="line-height:1.6;">{{expiry}}</p><p style="font-size:13px;color:#475569;">{{footer}}</p></td></tr>
    </table>
  </td></tr></table>
</body>
</html>
